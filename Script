local MyTab = Window:Tab({
    Title = "Главная",
    Icon = "home"
})

-- Твой рабочий полет (Fly)
MyTab:Toggle({
    Title = "Полет (Fly)",
    Value = false,
    Callback = function(state)
        if state then
            _G.Flying = true
            local player = game.Players.LocalPlayer
            local character = player.Character or player.CharacterAdded:Wait()
            local root = character:WaitForChild("HumanoidRootPart")
            local hum = character:WaitForChild("Humanoid")
            local cam = workspace.CurrentCamera
            
            _G.FlyBV = Instance.new("BodyVelocity")
            _G.FlyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            _G.FlyBV.Velocity = Vector3.new(0, 0, 0)
            _G.FlyBV.Parent = root
            
            task.spawn(function()
                while _G.Flying and root and hum do
                    if hum.MoveDirection.Magnitude > 0 then
                        _G.FlyBV.Velocity = cam.CFrame.LookVector * 50
                    else
                        _G.FlyBV.Velocity = Vector3.new(0, 0.1, 0)
                    end
                    task.wait()
                end
            end)
        else
            _G.Flying = false
            if _G.FlyBV then 
                _G.FlyBV:Destroy() 
            end
        end
    end
})


