-- 1. Fly Toggle
MyTab:Toggle({
    Title = "Fly",
    Value = false,
    Callback = function(state)
        if state then
            _G.Flying = true
            local player = game.Players.LocalPlayer
            local character = player.Character or player.CharacterAdded:Wait()
            local root = character:WaitForChild("HumanoidRootPart")
            local hum = character:WaitForChild("Humanoid")
            local cam = workspace.CurrentCamera
            
            _G.FlyBV = Instance.new("BodyVelocity")
            _G.FlyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            _G.FlyBV.Velocity = Vector3.new(0, 0, 0)
            _G.FlyBV.Parent = root
            
            task.spawn(function()
                while _G.Flying and root and hum do
                    if hum.MoveDirection.Magnitude > 0 then
                        -- Fly towards camera direction (Speed: 50)
                        _G.FlyBV.Velocity = cam.CFrame.LookVector * 50
                    else
                        -- Hover in place if no keys are pressed
                        _G.FlyBV.Velocity = Vector3.new(0, 0.1, 0)
                    end
                    task.wait() -- 1 frame delay
                end
            end)
        else
            _G.Flying = false
            if _G.FlyBV then 
                _G.FlyBV:Destroy() -- Restore gravity
            end
        end
    end
})

-- 2. ESP Toggle (Wallhack Highlight)
local espConnection
MyTab:Toggle({
    Title = "ESP (Highlight)",
    Value = false,
    Callback = function(state)
        _G.EspEnabled = state
        
        local function applyESP(player)
            if player ~= game.Players.LocalPlayer and player.Character then
                if _G.EspEnabled then
                    if not player.Character:FindFirstChild("EclipseESP") then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "EclipseESP"
                        highlight.FillColor = Color3.fromRGB(170, 0, 255) -- Signature Eclipse purple
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0
                        highlight.Parent = player.Character
                    end
                else
                    if player.Character:FindFirstChild("EclipseESP") then
                        player.Character.EclipseESP:Destroy()
                    end
                end
            end
        end

        if state then
            -- Connect listener for current and upcoming players
            espConnection = game.Players.PlayerAdded:Connect(function(player)
                player.CharacterAdded:Connect(function()
                    task.wait(0.5)
                    applyESP(player)
                end)
            end)
            
            for _, player in ipairs(game.Players:GetPlayers()) do
                applyESP(player)
            end
        else
            -- Disconnect and clean up highlights
            if espConnection then espConnection:Disconnect() end
            for _, player in ipairs(game.Players:GetPlayers()) do
                applyESP(player)
            end
        end
    end
})

-- 3. Infinite Jump Toggle
local infJumpConnection
MyTab:Toggle({
    Title = "Infinite Jump",
    Value = false,
    Callback = function(state)
        if state then
            infJumpConnection = game:GetService("UserInputService").JumpRequest:Connect(function()
                local player = game.Players.LocalPlayer
                if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
                    player.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
                end
            end)
        else
            if infJumpConnection then
                infJumpConnection:Disconnect()
            end
        end
    end
})


